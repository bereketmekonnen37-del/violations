# Copy to .env.local for local dev. On Vercel, set these exact names under
# Project Settings → Environment Variables (Production + Preview) and
# redeploy — Vite only inlines them at build time, so adding/changing them
# does not affect an already-built deployment until the next build.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Afromessage trial — used by /api/send-sms (server-only, never expose client-side).
# API key/token from https://afromessage.com dashboard. Sender ID and identifier
# ID are optional; set them if your account requires a specific sender name or
# the trial identifier from the "Application" section.
AFROMESSAGE_API_KEY=
AFROMESSAGE_SENDER_ID=
AFROMESSAGE_IDENTIFIER_ID=
