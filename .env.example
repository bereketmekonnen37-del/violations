# Copy to .env.local for local dev. On Vercel, set these exact names under
# Project Settings → Environment Variables (Production + Preview) and
# redeploy — Vite only inlines them at build time, so adding/changing them
# does not affect an already-built deployment until the next build.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
